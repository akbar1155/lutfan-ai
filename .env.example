# Database (local without Docker: sqlite:///absolute/path/to/backend/db.sqlite3)
DATABASE_URL=postgresql://lutfan:lutfan@localhost:5432/lutfan
# CELERY_TASK_ALWAYS_EAGER=true  # sync jobs without Redis worker (handy for local)
POSTGRES_USER=lutfan
POSTGRES_PASSWORD=lutfan
POSTGRES_DB=lutfan

# Redis
REDIS_URL=redis://localhost:6379/0

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-64-chars-xxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-64-chars-xxxxxxxxxxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=lutfan_ai_bot

# AI
GOOGLE_AI_API_KEY=
NANO_BANANA_MODEL=gemini-2.5-flash-image

# S3 / MinIO (local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=lutfan-public
S3_BUCKET_PRIVATE=lutfan-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CDN_BASE_URL=http://localhost:9000/lutfan-public

# App
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
# Leave empty for Vite/jprq proxy demos; set absolute URL if API is on another host
BACKEND_BASE_URL=
NODE_ENV=development
LOG_LEVEL=info

# Rate limiting
# 0 = unlimited (handy for local demos)
RATE_LIMIT_GENERATIONS_PER_HOUR=0
RATE_LIMIT_GENERATIONS_PER_DAY=0

# Sentry (Error Monitoring) - Leave empty to disable
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend (Vite) — use /api/v1 with Vite proxy (needed for jprq sharing)
VITE_API_BASE_URL=/api/v1
VITE_TELEGRAM_BOT_USERNAME=lutfan_ai_bot
VITE_TELEGRAM_AUTH_URL=http://localhost:8000/api/v1/auth/telegram
