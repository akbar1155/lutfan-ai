# Copy to .env.production on the server and fill real values.
# NEVER commit .env.production

# --- Database ---
POSTGRES_USER=lutfan
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=lutfan
DATABASE_URL=postgresql://lutfan:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/lutfan

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Django ---
DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
DJANGO_DEBUG=false
# Replace YOUR_SERVER_IP with public IP or domain
DJANGO_ALLOWED_HOSTS=YOUR_SERVER_IP,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP
CSRF_TRUSTED_ORIGINS=http://YOUR_SERVER_IP

# --- JWT ---
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_64_CHARS_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_64_CHARS_xxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=lutfan_ai_bot

# --- AI ---
GOOGLE_AI_API_KEY=
NANO_BANANA_MODEL=gemini-2.5-flash-image

# --- S3 / MinIO ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=lutfan-public
S3_BUCKET_PRIVATE=lutfan-private
S3_ACCESS_KEY=CHANGE_ME_MINIO_USER
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD_MIN_8
# Public URL for browsers to load invitation images (MinIO port 9000)
CDN_BASE_URL=http://YOUR_SERVER_IP:9000/lutfan-public

# --- App ---
# Public site is on :8080 (host :80 is another project). Leave BACKEND_BASE_URL
# empty so /media/ stays same-origin (http://IP:8080/media/...).
APP_BASE_URL=http://YOUR_SERVER_IP:8080
API_BASE_URL=http://YOUR_SERVER_IP:8080/api/v1
BACKEND_BASE_URL=
NODE_ENV=production
LOG_LEVEL=info
RUN_SEED=1
ALLOW_DEV_LOGIN=false
# Custom /admin panel username+password (created on container start)
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=admin123

# --- Rate limits ---
RATE_LIMIT_GENERATIONS_PER_HOUR=20
RATE_LIMIT_GENERATIONS_PER_DAY=50
